# Токен бота из https://discord.com/developers/applications (Bot -> Reset Token).
# ЭТОТ ФАЙЛ — ШАБЛОН И ЛЕЖИТ В GIT: настоящие ключи только в .env, он в .gitignore.
DISCORD_TOKEN=

# ID сервера для мгновенной синхронизации слеш-команд при разработке.
# Без него команды синхронизируются глобально (появляются до часа).
# DEV_GUILD_ID=1510324085421244431

LOG_LEVEL=INFO
# plain — читаемые логи для разработки, json — структурированные для продакшна
LOG_FORMAT=plain
# DEBUG-лог с ротацией (5 МБ x3); пусто = только консоль
LOG_FILE=logs/bot.log

# Логи бота в Discord-канал: ID канала (0 = выключено) и минимальный уровень.
# На лету меняется командой /botlog (админ).
DISCORD_LOG_CHANNEL=0
DISCORD_LOG_LEVEL=WARNING

# Путь к ffmpeg, если его нет в PATH (например, C:/ffmpeg/bin/ffmpeg.exe)
FFMPEG_PATH=ffmpeg

# Порт HTTP-сервера /health и /ready
HEALTH_PORT=8080

# --- База данных ---
# SQLite по умолчанию; для PostgreSQL: postgresql+asyncpg://user:pass@host:5432/db
# Приватность: при выходе бота с сервера данные помечаются и стираются через
# PRIVACY_PURGE_GRACE_DAYS дней (0 = сразу на ближайшем проходе). Проход раз в
# PRIVACY_PURGE_INTERVAL_HOURS часов. Участник может стереть себя сам — /forgetme.
# PRIVACY_PURGE_GRACE_DAYS=30
# PRIVACY_PURGE_INTERVAL_HOURS=6
# SQLite — ТОЛЬКО для локального запуска без Docker и для тестов (быстро, без сервера).
DATABASE_URL=sqlite+aiosqlite:///./poposya.db
AUTO_MIGRATE=true

# --- PostgreSQL (ОБЯЗАТЕЛЕН для Docker/прода; сервисы db/api/web из compose) ---
# В Docker БД всегда Postgres. Обе строки обязательны — без них `docker compose up`
# падает на разборе файла (:?), защита от тихого старта на пустом SQLite. Панели
# Postgres тоже нужен (командный мост панель<->бот на LISTEN/NOTIFY).
# POSTGRES_PASSWORD=придумайте_пароль
# BOT_DATABASE_URL=postgresql+asyncpg://poposya:придумайте_пароль@db:5432/poposya
# Discord OAuth (Developer Portal -> OAuth2; в Redirects добавьте адрес callback):
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# WEB_SESSION_SECRET=          # ОБЯЗАТЕЛЕН при включённой панели, >=32 символов (иначе старт упадёт).
#                              Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEB_OAUTH_REDIRECT=http://localhost:8081/api/auth/callback
# WEB_ALLOWED_ORIGIN=http://localhost:8081   # origin фронта (в Docker — порт 8081)
# WEB_PUBLIC_URL=                             # публичный адрес панели; если задан — бот покажет ссылку в приветствии при входе на сервер
# WEB_SESSION_VERSION=2        # аварийный logout всех: увеличьте на 1 -> все токены недействительны (v2 закрыл легаси-токены без маски прав)
# WEB_SESSION_TTL_HOURS=24     # АБСОЛЮТНЫЙ потолок жизни сессии от входа (даже при активности)
# WEB_IDLE_TTL_MINUTES=15      # скользящий тайм-аут бездействия (0 = выкл): простой дольше -> сервер выкидывает (истёкший токен), не только JS
# WEB_DOCS_ENABLED=false       # /docs, /openapi.json (по умолч. выкл; true только для локальной разработки)
# На публике поднимите HTTPS (см. web/TLS.md) и укажите https-адреса в WEB_OAUTH_REDIRECT/WEB_ALLOWED_ORIGIN

# --- монетизация / тарифы (подписки серверов) ---
# Тариф для серверов БЕЗ выданной оператором подписки. "free" (по умолчанию) =
# enforcement ВКЛючён: серверы без подписки получают Free, их лимиты клампятся,
# а подписки, выданные вручную в панели (вкладка «Подписка», только оператор),
# работают до своего срока. Поставьте "pro", чтобы временно ОТКЛючить платность
# (все серверы получают максимум). Значения: free | premium | pro.
# ENTITLEMENTS_DEFAULT_TIER=free

# --- лицензионные ключи Premium/Pro (docs/plans/premium-keys.md) ---
# Секрет подписи ключей (HMAC), ОТДЕЛЬНЫЙ от WEB_SESSION_SECRET. Пусто = выпуск и
# активация ключей выключены (вкладка «Ключи» покажет предупреждение, /activate
# ответит «недоступно»). Задан — обязан быть >=32 символов, иначе старт упадёт.
# Ротация секрета инвалидирует ВСЕ невыкупленные ключи. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# KEY_SIGNING_SECRET=
# анти-брутфорс активации: попыток на пользователя в час (по умолчанию 2)
# PREMIUM_KEY_ATTEMPTS_PER_HOUR=2
# срок годности невыкупленного ключа на полке, дней (по умолчанию 730)
# PREMIUM_KEY_SHELF_LIFE_DAYS=730

# --- WARDEN (внешний сторож; отдельный compose-проект) ---
# Заполняйте, только если поднимаете сторожа. Панель (вкладка WARDEN) и слэш
# /warden в боте ходят к его HTTP-API. Оба сервиса на общей docker-сети
# poposyap_default, поэтому адрес — по имени контейнера.
# Слэш /warden доступен только операторам из WEB_OPERATOR_IDS.
# WARDEN_API_URL=http://warden:9090
# WARDEN_API_TOKEN=            # read-токен (GET /status); совпадает с WARDEN_API_TOKEN в WARDEN/.env
# WARDEN_CONTROL_TOKEN=        # control-токен (POST /pause,/resume); least privilege. Пусто = управление по read-токену. Совпадает с WARDEN_CONTROL_TOKEN в WARDEN/.env
# HEALTH_FULL_TOKEN=           # токен доступа к /health/full (светит внутренности). Пусто = открыт. Включать по RUNBOOK: сперва WARDEN_HEALTH_TOKEN у сторожа, ПОТОМ это у бота (иначе ложный CRITICAL). Значение = WARDEN_HEALTH_TOKEN в WARDEN/.env

# --- AI (Groq, бесплатный тариф: https://console.groq.com/keys) ---
# Пусто = общение Попоси выключено, остальное (музыка, очки, роли) работает.
GROQ_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Надёжность: ретраи на 429/5xx, резервная модель, circuit breaker
AI_FALLBACK_MODEL=llama-3.1-8b-instant
AI_RETRY_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1.0
AI_CB_FAILURE_THRESHOLD=5
AI_CB_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=400
# бесплатный Groq ~30 запросов/мин — не задирайте конкурентность
AI_MAX_CONCURRENT=2
AI_CONTEXT_MESSAGES=12
AI_NOTES_UPDATE_EVERY=10
AI_EVENT_COMMENT_CHANCE=0.12
AI_EVENT_COMMENT_COOLDOWN=900

# --- Отношения (очки и роли) ---
RELATIONSHIP_DAILY_POINT_CAP=20
# Мягкое угасание: после N дней тишины −X очков раз в M дней
RELATIONSHIP_DECAY_AFTER_DAYS=30
RELATIONSHIP_DECAY_EVERY_DAYS=3
RELATIONSHIP_DECAY_POINTS=1
RELATIONSHIP_EXCLUSIVE_THRESHOLD=350
RELATIONSHIP_ABSENCE_DAYS=30
# имена ролей можно переопределить JSON-списком из 7 элементов:
# RELATIONSHIP_ROLE_NAMES=["☕ Случайный прохожий", "...", "✂️👁🖤 Единственный"]

# --- Антиспам ---
SPAM_LIMIT=5             # сколько сообщений за окно = спам
SPAM_WINDOW=10           # окно отслеживания, секунды
SPAM_MUTE_MINUTES=2      # длительность мута за спам

# --- Каналы ---
WELCOME_CHANNEL=bots     # канал приветствий и прощаний (название)
MAIN_CHANNEL=основной    # главный канал: активность, случайные реплики (название)
LOG_CHANNEL=0            # ID канала логов модерации (0 = отключено)

# --- Анкета знакомства (/introduce) ---
SURVEY_BONUS_POINTS=5  # разовый бонус очков за заполнение анкеты
# список интересов можно переопределить JSON-списком:
# SURVEY_INTEREST_OPTIONS=["Игры", "Аниме", "Музыка", "Арт", "Код", "Спорт", "Кино"]

# --- Дни рождения и праздники ---
BIRTHDAY_REMIND_DAYS=3        # за сколько дней напоминать о ДР
HOLIDAY_POINTS_MULTIPLIER=2   # множитель очков в праздники
# праздники можно переопределить JSON-объектом "ДД-ММ": "название":
# HOLIDAYS={"01-01": "Новый год", "14-02": "День святого Валентина", "31-10": "Хэллоуин", "25-12": "Рождество"}

# --- Доставка сообщений (/send) ---
SEND_PER_HOUR=5  # лимит отправок на пользователя в час

# --- Секретная комната ---
SECRET_ROOM_MIN_LEVEL=5     # уровень отношений для ключа и видимости комнаты
SECRET_ROOM_HOURS=12        # время жизни комнаты
SECRET_ROOM_TEXT_NAME=🖤-тайная-комната
SECRET_ROOM_VOICE_NAME=🖤 Тайная комната

# --- Альбом Попоси (starboard) ---
ALBUM_CHANNEL=альбом-попоси   # канал-альбом (название)
ALBUM_REACTION_THRESHOLD=5    # реакций для попадания в альбом
ALBUM_REACTION_EMOJI=         # конкретное эмодзи (например 👁); пусто = любое

# --- Модерация ---
WARN_THRESHOLD=3         # варнов до мута
WARN_MUTE_MINUTES=120    # длительность мута при накоплении варнов

# Роль новичку при входе (название существующей роли; пусто = выключено)
AUTO_ROLE=

# --- Активность бота (нужен GROQ_API_KEY) ---
LONELY_HOURS=12              # часов тишины в главном канале до «скучаю»
ABSENT_DAYS_THRESHOLD=7      # дней отсутствия участника до «с возвращением»
RANDOM_THOUGHT_MIN_HOURS=3   # случайные реплики: минимальный интервал
RANDOM_THOUGHT_MAX_HOURS=6   # случайные реплики: максимальный интервал

# --- Музыка ---
MUSIC_DEFAULT_VOLUME=0.5
MUSIC_PLAYLIST_LIMIT=50
MUSIC_IDLE_TIMEOUT=300
MUSIC_IDLE_WARN_SECONDS=120   # за сколько до выхода спросить «включить ещё?»
MUSIC_PROGRESS_INTERVAL=10
MUSIC_SEARCH_LIMIT=5
MUSIC_PLAYLIST_MAX_PER_GUILD=25   # лимит сохранённых плейлистов на сервер
MUSIC_PLAYLIST_MAX_TRACKS=100     # лимит треков в одном плейлисте

# Кэш аудио: следующие треки очереди скачиваются на диск заранее и играют
# из файла — без заиканий и «ускорений» живого стрима. Первый трек стартует
# мгновенно стримом, остальные успевают скачаться. 0 = выключить.
MUSIC_PREFETCH_TRACKS=3
MUSIC_CACHE_DIR=data/audio_cache  # в Docker этот путь лежит на volume bot_data
MUSIC_CACHE_MAX_MB=300            # при превышении удаляются самые старые файлы

# Spotify API — включает поддержку плейлистов и альбомов: бот берёт список
# треков через Spotify Web API и ищет каждый на YouTube. Ключи с
# https://developer.spotify.com/dashboard (Client ID/Secret). Без них плейлисты
# недоступны, а одиночные ссылки на треки работают всё равно (через oEmbed).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- GitHub-репозитории (/git add owner/name → релизы в форум-канал) ---
# Токен опционален. Пусто = анонимно, 60 запросов/ч на IP (хватает на несколько
# репозиториев при опросе раз в 15 мин). С токеном — 5000/ч. Только публичные
# репозитории; подойдёт классический PAT вообще без прав (public read).
GITHUB_TOKEN=
# Как часто опрашивать GitHub на новые релизы (минуты). При 120 (2 ч)
# анонимного лимита 60/ч хватает даже на десятки репозиториев.
GITHUB_POLL_INTERVAL_MINUTES=120

# --- Steam-игры (/steam add <AppID> → официальные новости в форум-канал) ---
# Ключ не нужен: новости берутся через официальный ISteamNews (без ключа).
# Как часто опрашивать Steam на новые новости игр (минуты).
STEAM_POLL_INTERVAL_MINUTES=120

# Cookies лечат «Sign in to confirm you're not a bot» И часть упрямых 403
# (треки с URL, привязанным к клиенту). Рекомендуемый способ — файл:
# экспортируйте cookies youtube.com расширением «Get cookies.txt LOCALLY»
# (Netscape-формат). В Docker: положите файл в ./secrets/ (монтируется в
# /app/secrets, только чтение) и укажите путь внутри контейнера:
# YTDLP_COOKIES_FILE=/app/secrets/youtube-cookies.txt
# Вне Docker — просто абсолютный путь: YTDLP_COOKIES_FILE=C:/Users/you/cookies.txt
# Несуществующий путь безопасен: cookies просто не применяются (см. лог-warning).
# Либо брать прямо из браузера (браузер ЗАКРЫТ, только вне Docker):
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Дополнительный/альтернативный рычаг против c=ANDROID_VR-403 — форс player-клиента
# (через запятую; пусто = дефолт yt-dlp):
# YTDLP_PLAYER_CLIENTS=web_safari,web
